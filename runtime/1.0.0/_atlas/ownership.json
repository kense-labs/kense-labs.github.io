    { "role": "业务进程", "owns": ["turn", "tool_names", "stable_paths"], "must_not": ["runtime_sdk", "host_absolute_paths"] },
    { "role": "Runtime", "owns": ["isolation", "session_forwarding", "optional_relay"], "must_not": ["product_semantics"] }
  ]
}